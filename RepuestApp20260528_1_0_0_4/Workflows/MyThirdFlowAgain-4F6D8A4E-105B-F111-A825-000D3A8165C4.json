    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "When_a_new_response_is_submitted": {
          "splitOn": "@triggerOutputs()?['body/value']",
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "parameters": {
              "form_id": "GTKPF00rCEmHjcDDweSfL-CiN3AnM4pKs7wS8w3WIqtUMEZVU0dXQksyR1VLRlBMMTNKR0NPUlJINS4u"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_microsoftforms",
              "operationId": "CreateFormWebhook",
              "connectionName": "shared_microsoftforms"
            }
          }
        }
      },
      "actions": {
        "Get_response_details": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "form_id": "GTKPF00rCEmHjcDDweSfL-CiN3AnM4pKs7wS8w3WIqtUMEZVU0dXQksyR1VLRlBMMTNKR0NPUlJINS4u",
              "response_id": "@triggerOutputs()?['body/resourceData/responseId']"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_microsoftforms",
              "operationId": "GetFormResponseById",
              "connectionName": "shared_microsoftforms"
            }
          }
        },
        "Start_and_wait_for_an_approval": {
          "runAfter": {
            "Get_response_details": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "parameters": {
              "approvalType": "Basic",
              "WebhookApprovalCreationInput/title": "Approval Request – Demo Form",
              "WebhookApprovalCreationInput/assignedTo": "admin@M365x04349104.onmicrosoft.com",
              "WebhookApprovalCreationInput/details": "@outputs('Get_response_details')?['body/r7fb669ea08a94bb58fbab74ad88e3453']",
              "WebhookApprovalCreationInput/enableNotifications": true,
              "WebhookApprovalCreationInput/enableReassignment": true
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_approvals",
              "operationId": "StartAndWaitForAnApproval",
              "connectionName": "shared_approvals"
            }
          }
        },
        "Condition": {
          "actions": {
            "Post_message_in_a_chat_or_channel": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "poster": "User",
                  "location": "Group chat",
                  "body/recipient": "48:notes",
                  "body/messageBody": "<p class=\"editor-paragraph\">Your request has been approved!</p>"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                  "operationId": "PostMessageToConversation",
                  "connectionName": "shared_teams"
                }
              }
            }
          },
          "runAfter": {
            "Start_and_wait_for_an_approval": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {
              "Post_message_in_a_chat_or_channel_1": {
                "type": "OpenApiConnection",
                "inputs": {
                  "parameters": {
                    "poster": "User",
                    "location": "Group chat",
                    "body/recipient": "48:notes",
                    "body/messageBody": "<p class=\"editor-paragraph\">Your request has been rejected!</p><br><p class=\"editor-paragraph\">@{outputs('Start_and_wait_for_an_approval')?['body/responseSummary']}</p>"
                  },
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                    "operationId": "PostMessageToConversation",
                    "connectionName": "shared_teams"
                  }
                }
              }
            }
          },
          "expression": {
            "and": [
              {
                "equals": [
                  "@outputs('Start_and_wait_for_an_approval')?['body/outcome']",
                  "Approve"
                ]
              }
            ]
          },
          "type": "If"
        }
      },
      "outputs": {}
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}